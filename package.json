{
  "name": "@vitoria-rodrigues/lumini-estetica",
  "version": "1.0.0",
  "private": true,
  "description": "Root monorepo workspace for the ecosystem.",
  "author": "Vitória Rodrigues Ferreira",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vitoria-Rodrigues/Lumini-Estetica.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0"
    }
  },
  "scripts": {
    "app:dev": "pnpm --filter \"@lumini-estetica/app\" dev",
    "app:build": "turbo run build --filter=\"@lumini-estetica/app\"",
    "app:typecheck": "turbo run typecheck --filter=\"@lumini-estetica/app\"",
    "app:lint": "turbo run lint --filter=\"@lumini-estetica/app\"",
    "docs:dev": "pnpm --filter \"@lumini-estetica/docs\" start",
    "docs:build": "turbo run build --filter=\"@lumini-estetica/docs\"",
    "docs:typecheck": "turbo run typecheck --filter=\"@lumini-estetica/docs\"",
    "docs:lint": "turbo run lint --filter=\"@lumini-estetica/docs\"",
    "docs:down": "pnpm dlx kill-port 3002",
    "format:check": "prettier --check --ignore-path .prettierignore .",
    "format:write": "prettier --write --ignore-path .prettierignore .",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@docusaurus/eslint-plugin": "catalog:tooling-stack",
    "@eslint-react/eslint-plugin": "catalog:web-stack",
    "@eslint/js": "catalog:tooling-stack",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:tooling-stack",
    "eslint": "catalog:tooling-stack",
    "eslint-config-prettier": "catalog:tooling-stack",
    "eslint-import-resolver-typescript": "catalog:tooling-stack",
    "eslint-plugin-import-x": "catalog:tooling-stack",
    "eslint-plugin-mdx": "catalog:tooling-stack",
    "eslint-plugin-prettier": "catalog:tooling-stack",
    "eslint-plugin-react-refresh": "catalog:web-stack",
    "eslint-plugin-react-hooks": "catalog:tooling-stack",
    "globals": "catalog:tooling-stack",
    "jiti": "catalog:tooling-stack",
    "kill-port": "catalog:",
    "prettier": "catalog:tooling-stack",
    "rimraf": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:tooling-stack"
  }
}
